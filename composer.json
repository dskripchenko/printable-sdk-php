{
    "name": "dskripchenko/printable-sdk",
    "description": "Official PHP SDK for the Printable document-generation service: HMAC-signed integration API client (templates, print-forms, batches, drafts, webhooks).",
    "keywords": ["printable", "sdk", "api-client", "pdf", "docx", "document-generation", "hmac"],
    "homepage": "https://github.com/dskripchenko/printable-sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "homepage": "https://github.com/dskripchenko"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\PrintableSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
